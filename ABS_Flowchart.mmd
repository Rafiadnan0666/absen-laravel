            EMP_LEAVES["/employee/leaves
                Submit & view leave requests"]:::emp
            EMP_REIMB["/employee/reimbursements
                Submit & view claims"]:::emp
            EMP_PAYROLL["/employee/payrolls
                View payslips"]:::emp
            EMP_ANNOUNCE["/employee/announcements
                View announcements"]:::emp
            EMP_ATTLOG["/employee/attendance-logs
                View personal logs"]:::emp
        end
    end

    %% ==================== API ====================
    subgraph API["📡 REST API — /api/* (Sanctum Token Auth)"]
        API_LOGIN["POST /api/login → token"]:::api
        API_REGISTER["POST /api/register → token"]:::api
        API_USER["GET /api/user → user + role + dept + job"]:::api
        API_LOGOUT["POST /api/logout → revoke token"]:::api
        API_USERS["/api/users — CRUD"]:::api
        API_ATTEND["/api/attendances — CRUD"]:::api
        API_LEAVES["/api/leaves — CRUD"]:::api
        API_PAYROLL["/api/payrolls — GET"]:::api
        API_REIMB["/api/reimbursements — CRUD"]:::api
        API_DEPT["/api/departments — GET"]:::api
    end

    %% ==================== SHARED COMPONENTS ====================
    subgraph SHARED["🧩 Shared Blade Components & Layouts"]
        LAYOUT_APP["<x-app-layout>
            layouts/app.blade.php
            + navigation.blade.php"]:::shared
        LAYOUT_GUEST["<x-guest-layout>
            layouts/guest.blade.php"]:::shared
        LAYOUT_EMP["layouts/employee.blade.php
            Full sidebar + navbar
            + Profile Modal
            + Onboarding Tour"]:::shared
        LAYOUT_ADMIN["admin/dashboard/layout.blade.php
            Full sidebar (22 nav items)
            + Profile Modal
            + Onboarding Tour
            + Link prefetch"]:::shared
        LAYOUT_HR["hr/dashboard/layout.blade.php
            Sidebar (5 nav items)"]:::shared
        
        COMP_PROFILE["components/profile-modal.blade.php
            Alpine.js profile editor"]:::shared
        COMP_TOUR["components/onboarding-tour.blade.php
            Spotlight + tooltip (Alpine.js)
            3 role-based step sets"]:::shared
        COMP_TABLE["components/table-search.blade.php
            Alpine.js AJAX table filter"]:::shared
        COMP_MODAL["components/modal.blade.php"]:::shared
        COMP_DROPDOWN["components/dropdown.blade.php"]:::shared
    end

    %% ==================== MODELS / DATABASE ====================
    subgraph DB["🗄️ Models (26 Eloquent Models) & Database (22+ tables)"]
        M_USER["User
            • BelongsTo: Role, Department, JobTitle
            • HasMany: Attendance, Leave, Payroll,
              Reimbursement, FaceLog, AttendanceLog
            • HasApiTokens (Sanctum)"]:::model
        M_ROLE["Role
            • nama_role: admin | hr | employee
            • BelongsToMany: Permission"]:::model
        M_PERM["Permission
            • BelongsToMany: Role"]:::model
        M_DEPT["Department
            • HasMany: User"]:::model
        M_JOB["JobTitle
            • HasMany: User"]:::model
        M_SHIFT["Shift
            • HasMany: UserShift"]:::model
        M_USERSHIFT["UserShift"]:::model
        M_ATTEND["Attendance
            • check_in, check_out, work_hours
            • overtime_minutes, late_minutes, early_leave_minutes
            • status: present | late | absent"]:::model
        M_ATTLOG2["AttendanceLog
            • Raw log entries with GPS & photo"]:::model
        M_FACE["FaceLog
            • Face verification attempts"]:::model
        M_LEAVE["Leave
            • tipe_cuti, start_date, end_date
            • status: pending | approved | rejected"]:::model
        M_PAYROLL["Payroll
            • period_start, period_end
            • base_salary, overtime_total
            • deductions, bonus, total_pay
            • status: paid | pending"]:::model
        M_PAYDET["PayrollDetail
            • Line items per payroll"]:::model
        M_REIMB2["Reimbursement
            • category, amount
            • status: pending | approved | rejected"]:::model
        M_LOC["Location
            • lat, lng, radius_meter"]:::model
        M_HOL["Holiday"]:::model
        M_ANN["Announcement"]:::model
        M_SAL["SalaryRule
            • overtime_rate, late_penalty, absence_penalty"]:::model
        M_OVT["OvertimeRule
            • min_hours, multiplier"]:::model
    end

    %% ==================== CROSS-CUTTING ====================
    subgraph CROSS["🔀 Cross-Cutting Concerns"]
        MIDDLEWARE["Middleware
            • CheckAdminRole (admin)
            • CheckHRRole (hr)
            • ForceHttps (https)
            • HandleInertiaRequests (unused)"]:::shared
        POLICIES["Policies (9)
            • User, Department, JobTitle
            • Shift, Location
            • Leave, Attendance
            • Reimbursement, Payroll"]:::shared
        GATES["Gates
            • isAdmin, isHR, isEmployee"]:::shared
        VITE["Build: Vite + laravel-vite-plugin
            • Tailwind CSS 3.x
            • Alpine.js 3.x
            • Chart.js 4.x
            • Soft UI Dashboard theme"]:::shared
        FORMS["Form Requests (9)
            • Rate-limited LoginRequest
            • Store*Request validation"]:::shared
    end

    %% ==================== CONNECTIONS ====================
    AUTH_LOGIN --> LOGIN_CHECK --> ROLE_CHECK
    ROLE_CHECK -- admin --> AD_DASH
    ROLE_CHECK -- hr --> HR_DASHBOARD
    ROLE_CHECK -- employee --> EMP_DASHBOARD

    AD_CRUD ---->|read/write| M_USER
    AD_CRUD ---->|read/write| M_DEPT
    AD_CRUD ---->|read/write| M_JOB
    AD_CRUD ---->|read/write| M_ROLE
    AD_CRUD ---->|read/write| M_PERM
    AD_CRUD ---->|read/write| M_SHIFT
    AD_CRUD ---->|read/write| M_USERSHIFT
    AD_CRUD ---->|read/write| M_LOC
    AD_CRUD ---->|read/write| M_HOL
    AD_CRUD ---->|read/write| M_ANN
    AD_CRUD ---->|read/write| M_SAL
    AD_CRUD ---->|read/write| M_OVT

    AD_MONITOR -->|read/write| M_ATTEND
    AD_MONITOR -->|read/write| M_LEAVE
    AD_MONITOR -->|read/write| M_PAYROLL
    AD_MONITOR -->|read/write| M_REIMB2
    AD_MONITOR -->|read/write| M_ATTLOG2
    AD_MONITOR -->|read/write| M_FACE
    AD_MONITOR --> M_PAYDET

    EMP_SELF -->|create/read own| M_ATTEND
    EMP_SELF -->|create/read own| M_LEAVE
    EMP_SELF -->|create/read own| M_REIMB2
    EMP_SELF -->|read own| M_PAYROLL
    EMP_SELF -->|read| M_ANN
    EMP_SELF -->|read own| M_ATTLOG2

    HR_ATTEND --->|read| M_ATTEND
    HR_LEAVES --->|read/write| M_LEAVE
    HR_PAYROLL --->|read| M_PAYROLL
    HR_REIMB --->|read/write| M_REIMB2

    API_LOGIN --> M_USER
    API_REGISTER --> M_USER
    API_USER --> M_USER
    API_USERS --> M_USER
    API_ATTEND --> M_ATTEND
    API_LEAVES --> M_LEAVE
    API_PAYROLL --> M_PAYROLL
    API_REIMB --> M_REIMB2
    API_DEPT --> M_DEPT
